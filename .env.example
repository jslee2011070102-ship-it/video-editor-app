# Claude API (Anthropic) - 스크립트/기획/레퍼런스 탐색에 사용
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pexels API - 무료 스톡 영상 다운로드 (https://www.pexels.com/api/ 에서 발급)
# 월 200 크레딧 무료 (영상 1개당 약 1 크레딧)
PEXELS_API_KEY=your_pexels_api_key_here

# 출력 설정
OUTPUT_DIR=output
SHORTS_DURATION=60        # 쇼츠 목표 길이 (초)
SHORTS_RESOLUTION=1080x1920  # 세로 영상 (9:16)
TTS_VOICE=ko-KR-SunHiNeural  # edge-tts 한국어 음성
