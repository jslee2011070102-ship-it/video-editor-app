# ── shorts_automation 파이프라인 API 키 ──────────────────────────────────
#
# 발급 방법:
#   YOUTUBE_API_KEY  : https://console.cloud.google.com
#                      새 프로젝트 → YouTube Data API v3 활성화 → 사용자 인증 정보 → API 키
#
#   GEMINI_API_KEY   : https://aistudio.google.com
#                      로그인 → "Get API Key" → "Create API key"
#                      (AIza 로 시작하는 문자열)
#
#   ANTHROPIC_API_KEY: https://console.anthropic.com  (Claude로 교체 시)
#                      AI_PROVIDER=claude 로 변경 필요

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# AI 제공자 선택: gemini(기본) 또는 claude
AI_PROVIDER=gemini

# Claude로 교체 시 아래 값 입력 + AI_PROVIDER=claude 설정
ANTHROPIC_API_KEY=sk-ant-...
